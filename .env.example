# Copy to .env and change every secret before any non-local deployment.
POSTGRES_PASSWORD=postgres-dev
AUTH_DB_PASSWORD=auth-dev
LISTINGS_DB_PASSWORD=listings-dev
JWT_SECRET=dev-jwt-secret-change-me-32-bytes-min
MEILI_MASTER_KEY=dev-meili-master-key-change-me
S3_ACCESS_KEY=kup
S3_SECRET_KEY=dev-s3-secret-change-me
# Returns OTP codes in API responses. MUST be false in production.
OTP_DEV_MODE=true
# Public URL of the gateway as seen by browsers/apps.
PUBLIC_API_URL=http://localhost:8180
