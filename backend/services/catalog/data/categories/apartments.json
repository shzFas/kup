    {"key": "ownership", "type": "enum", "label": {"ru": "Тип собственности", "uk": "Форма власності", "cs": "Vlastnictví", "en": "Ownership"}, "group": "deal", "required": true, "options": [{"value": "personal", "label": {"ru": "Личная (osobní)", "uk": "Особиста (osobní)", "cs": "Osobní", "en": "Freehold (osobní)"}}, {"value": "cooperative", "label": {"ru": "Кооперативная (družstevní)", "uk": "Кооперативна (družstevní)", "cs": "Družstevní", "en": "Cooperative (družstevní)"}}, {"value": "municipal", "label": {"ru": "Муниципальная (obecní)", "uk": "Муніципальна (obecní)", "cs": "Obecní / státní", "en": "Municipal (obecní)"}}], "depends_on": {"key": "deal_type", "values": ["sale"]}, "hint": {"ru": "Osobní — вы полноправный собственник. Družstevní — покупаете пай в кооперативе с правом пользования, ипотеку дают реже.", "uk": "Osobní — ви повноправний власник. Družstevní — купуєте пай у кооперативі з правом користування, іпотеку дають рідше.", "cs": "Osobní = jste vlastníkem bytu. Družstevní = kupujete členský podíl v družstvu s právem užívání; hypotéka je hůř dostupná.", "en": "Osobní = you own the flat. Družstevní = you buy a co-op share with the right to use it; mortgages are harder to get."}, "filter": {"facet": true}},
