    {"key": "furnished", "type": "enum", "label": {"ru": "Мебель", "uk": "Меблі", "cs": "Vybavení", "en": "Furnishing"}, "group": "flat", "required": false, "options": [{"value": "unfurnished", "label": {"ru": "Без мебели", "uk": "Без меблів", "cs": "Nevybavený", "en": "Unfurnished"}}, {"value": "partly", "label": {"ru": "Частично с мебелью", "uk": "Частково з меблями", "cs": "Částečně vybavený", "en": "Part-furnished"}}, {"value": "furnished", "label": {"ru": "С мебелью", "uk": "З меблями", "cs": "Vybavený", "en": "Furnished"}}], "hint": {"ru": "Даже «без мебели» в Чехии обычно есть кухня с плитой. Холодильник и стиральную машину уточняйте.", "uk": "Навіть «без меблів» у Чехії зазвичай є кухня з плитою. Холодильник і пральну машину уточнюйте.", "cs": "I nevybavený byt mívá kuchyňskou linku se sporákem. Lednici a pračku si ověřte.", "en": "Even “unfurnished” Czech flats usually have a fitted kitchen with a stove. Ask about the fridge and washer."}, "filter": {"facet": true}},
    {"key": "features", "type": "multi_enum", "label": {"ru": "Удобства", "uk": "Зручності", "cs": "Příslušenství", "en": "Features"}, "group": "flat", "required": false, "options": [{"value": "balcony", "label": {"ru": "Балкон", "uk": "Балкон", "cs": "Balkon", "en": "Balcony"}}, {"value": "loggia", "label": {"ru": "Лоджия", "uk": "Лоджія", "cs": "Lodžie", "en": "Loggia"}}, {"value": "terrace", "label": {"ru": "Терраса", "uk": "Тераса", "cs": "Terasa", "en": "Terrace"}}, {"value": "cellar", "label": {"ru": "Подвал / кладовая (sklep)", "uk": "Підвал / комора (sklep)", "cs": "Sklep", "en": "Cellar storage (sklep)"}}, {"value": "parking", "label": {"ru": "Парковочное место", "uk": "Паркомісце", "cs": "Parkovací stání", "en": "Parking space"}}, {"value": "garage", "label": {"ru": "Гараж", "uk": "Гараж", "cs": "Garáž", "en": "Garage"}}, {"value": "elevator", "label": {"ru": "Лифт", "uk": "Ліфт", "cs": "Výtah", "en": "Lift"}}, {"value": "garden", "label": {"ru": "Сад / палисадник", "uk": "Сад / палісадник", "cs": "Zahrada / předzahrádka", "en": "Garden"}}, {"value": "barrier_free", "label": {"ru": "Без барьеров (для колясок)", "uk": "Безбар'єрний доступ", "cs": "Bezbariérový", "en": "Step-free access"}}], "filter": {"widget": "multi_all"}},
    {"key": "building_type", "type": "enum", "label": {"ru": "Тип дома", "uk": "Тип будинку", "cs": "Stavba", "en": "Construction"}, "group": "house", "required": false, "options": [{"value": "brick", "label": {"ru": "Кирпичный (cihla)", "uk": "Цегляний (cihla)", "cs": "Cihlová", "en": "Brick"}}, {"value": "panel", "label": {"ru": "Панельный (panelák)", "uk": "Панельний (panelák)", "cs": "Panelová", "en": "Panel (prefab)"}}, {"value": "mixed", "label": {"ru": "Смешанный", "uk": "Змішаний", "cs": "Smíšená", "en": "Mixed"}}, {"value": "skeleton", "label": {"ru": "Каркасный (монолит)", "uk": "Каркасний (моноліт)", "cs": "Skeletová", "en": "Concrete frame"}}, {"value": "wooden", "label": {"ru": "Деревянный (dřevostavba)", "uk": "Дерев'яний (dřevostavba)", "cs": "Dřevostavba", "en": "Timber"}}], "hint": {"ru": "Panelák — типовые панельные дома 1960–90-х, многие уже утеплены и отремонтированы. Cihla — кирпич.", "uk": "Panelák — типові панельні будинки 1960–90-х, багато з них уже утеплені й відремонтовані. Cihla — цегла.", "cs": "Panelák = typový panelový dům z let 1960–90, často již zateplený a revitalizovaný.", "en": "Panelák = prefab panel blocks from the 1960s–90s, many now insulated and refurbished. Cihla = brick."}, "filter": {"facet": true}},
    {"key": "energy_class", "type": "enum", "label": {"ru": "Энергокласс (PENB)", "uk": "Енергоклас (PENB)", "cs": "Energetická náročnost (PENB)", "en": "Energy rating (PENB)"}, "group": "house", "required": false, "options": [{"value": "a", "label": "A"}, {"value": "b", "label": "B"}, {"value": "c", "label": "C"}, {"value": "d", "label": "D"}, {"value": "e", "label": "E"}, {"value": "f", "label": "F"}, {"value": "g", "label": "G"}], "hint": {"ru": "PENB — энергетический паспорт дома: A — очень экономичный, G — очень затратный. Влияет на счета за отопление.", "uk": "PENB — енергетичний паспорт будинку: A — дуже економний, G — дуже витратний. Впливає на рахунки за опалення.", "cs": "Průkaz energetické náročnosti budovy: A = mimořádně úsporná, G = mimořádně nehospodárná.", "en": "PENB is the building's energy certificate: A = very efficient, G = very inefficient. Affects heating bills."}, "filter": {"facet": true}},
    {"key": "heating", "type": "enum", "label": {"ru": "Отопление", "uk": "Опалення", "cs": "Vytápění", "en": "Heating"}, "group": "house", "required": false, "options": [{"value": "district", "label": {"ru": "Центральное (теплосеть)", "uk": "Центральне (тепломережа)", "cs": "Dálkové (ústřední)", "en": "District heating"}}, {"value": "gas", "label": {"ru": "Газовый котёл", "uk": "Газовий котел", "cs": "Plynový kotel", "en": "Gas boiler"}}, {"value": "electric", "label": {"ru": "Электрическое", "uk": "Електричне", "cs": "Elektrické", "en": "Electric"}}, {"value": "heat_pump", "label": {"ru": "Тепловой насос", "uk": "Тепловий насос", "cs": "Tepelné čerpadlo", "en": "Heat pump"}}, {"value": "other", "label": {"ru": "Другое", "uk": "Інше", "cs": "Jiné", "en": "Other"}}], "filter": {"facet": true}},
    {"key": "year_built", "type": "int", "label": {"ru": "Год постройки", "uk": "Рік побудови", "cs": "Rok výstavby", "en": "Year built"}, "group": "house", "required": false, "min": 1800, "max": 2032, "filter": {"presets": [1990, 2005, 2015, 2020]}},
    {"key": "mortgage", "type": "bool", "label": {"ru": "Возможна ипотека", "uk": "Можлива іпотека", "cs": "Možnost hypotéky", "en": "Mortgage possible"}, "group": "deal", "required": false, "depends_on": {"key": "deal_type", "values": ["sale"]}, "filter": {"label": {"ru": "Ипотека", "uk": "Іпотека", "cs": "Hypotéka", "en": "Mortgage"}}},
    {"key": "deposit_czk", "type": "int", "label": {"ru": "Залог (kauce)", "uk": "Застава (kauce)", "cs": "Kauce", "en": "Deposit (kauce)"}, "group": "terms", "required": false, "min": 0, "max": 1000000, "unit": "Kč", "depends_on": {"key": "deal_type", "values": ["rent_long"]}, "hint": {"ru": "Возвращается при выезде, если нет долгов и повреждений. Обычно 1–3 месячные платы, по закону не больше трёх.", "uk": "Повертається при виїзді, якщо немає боргів і пошкоджень. Зазвичай 1–3 місячні плати, за законом не більше трьох.", "cs": "Vrací se při odchodu, pokud nejsou dluhy ani škody. Obvykle 1–3 nájmy, ze zákona nejvýše trojnásobek.", "en": "Refunded on move-out if there are no debts or damage. Usually 1–3 months' rent; legally capped at three."}, "filter": {"presets": [20000, 40000, 60000]}},
