{
  "slug": "apartments", "name": "Квартиры", "icon": "apartment", "position": 4,
  "groups": [
    { "key": "deal", "label": "Сделка" },
    { "key": "flat", "label": "Квартира" },
    { "key": "house", "label": "Дом" },
    { "key": "terms", "label": "Условия" }
  ],
  "highlights": ["rooms", "area_total", "floor_label", "building_type", "renovation"],
  "sorts": [
    { "value": "date_desc", "label": "Сначала новые" },
    { "value": "price_asc", "label": "Сначала дешёвые" },
    { "value": "price_desc", "label": "Сначала дорогие" },
    { "value": "price_per_m2_asc", "label": "Цена за м²: дешевле" },
    { "value": "area_desc", "label": "Площадь: больше" }
  ],
  "attributes": [
    { "key": "deal_type", "type": "enum", "label": "Тип сделки", "group": "deal", "required": true,
      "options": [ { "value": "sale", "label": "Продажа" }, { "value": "rent_long", "label": "Аренда помесячно" }, { "value": "rent_daily", "label": "Посуточно" } ],
      "filter": { "widget": "select", "label": "Сделка", "pinned": true, "facet": true } },
    { "key": "market", "type": "enum", "label": "Рынок", "group": "deal", "required": true,
      "depends_on": { "key": "deal_type", "values": ["sale"] },
      "options": [ { "value": "secondary", "label": "Вторичка" }, { "value": "new", "label": "Новостройка" } ],
      "filter": { "facet": true } },
    { "key": "from_owner", "type": "bool", "label": "От собственника", "group": "deal", "required": false,
      "filter": {} },

    { "key": "rooms", "type": "enum", "label": "Комнат", "group": "flat", "required": true,
      "options": [ { "value": "studio", "label": "Студия" }, { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5+" } ],
      "filter": { "pinned": true, "facet": true } },
    { "key": "area_total", "type": "decimal", "label": "Общая площадь", "unit": "м²", "group": "flat", "required": true, "min": 8, "max": 1000, "step": 0.1,
      "filter": { "label": "Площадь", "pinned": true, "presets": [30, 45, 60, 80, 100] } },
    { "key": "area_kitchen", "type": "decimal", "label": "Площадь кухни", "unit": "м²", "group": "flat", "required": false, "min": 2, "max": 100, "step": 0.1,
      "filter": { "label": "Кухня" } },
    { "key": "floor", "type": "int", "label": "Этаж", "group": "flat", "required": true, "min": -1, "max": 120,
      "filter": {} },
    { "key": "floors_total", "type": "int", "label": "Этажей в доме", "group": "house", "required": true, "min": 1, "max": 120,
      "filter": { "label": "Этажность" } },
    { "key": "not_first_floor", "type": "bool", "label": "Не первый этаж", "group": "flat", "required": false, "computed": true,
      "filter": {} },
    { "key": "not_last_floor", "type": "bool", "label": "Не последний этаж", "group": "flat", "required": false, "computed": true,
      "filter": {} },
    { "key": "floor_label", "type": "text", "label": "Этаж", "group": "flat", "required": false, "computed": true },
    { "key": "ceiling_m", "type": "decimal", "label": "Высота потолков", "unit": "м", "group": "flat", "required": false, "min": 2, "max": 6, "step": 0.05,
      "filter": { "presets": [2.7, 3.0] } },
    { "key": "bathroom", "type": "enum", "label": "Санузел", "group": "flat", "required": false,
      "options": [ { "value": "combined", "label": "Совмещённый" }, { "value": "separate", "label": "Раздельный" }, { "value": "multiple", "label": "2 и более" } ],
      "filter": { "facet": true } },
    { "key": "balcony", "type": "enum", "label": "Балкон", "group": "flat", "required": false,
      "options": [ { "value": "none", "label": "Нет" }, { "value": "balcony", "label": "Балкон" }, { "value": "loggia", "label": "Лоджия" }, { "value": "multiple", "label": "Несколько" } ],
      "filter": {} },
    { "key": "renovation", "type": "enum", "label": "Ремонт", "group": "flat", "required": false,
      "options": [ { "value": "none", "label": "Без ремонта" }, { "value": "rough", "label": "Черновая отделка" }, { "value": "cosmetic", "label": "Косметический" }, { "value": "euro", "label": "Евроремонт" }, { "value": "designer", "label": "Дизайнерский" } ],
      "filter": { "facet": true } },

    { "key": "building_type", "type": "enum", "label": "Тип дома", "group": "house", "required": false,
      "options": [ { "value": "panel", "label": "Панельный" }, { "value": "brick", "label": "Кирпичный" }, { "value": "monolith", "label": "Монолитный" }, { "value": "monolith_brick", "label": "Монолитно-кирпичный" }, { "value": "block", "label": "Блочный" }, { "value": "wood", "label": "Деревянный" } ],
      "filter": { "facet": true } },
    { "key": "year_built", "type": "int", "label": "Год постройки", "group": "house", "required": false, "min": 1900, "max": 2032,
      "filter": { "presets": [1990, 2005, 2015, 2020] } },
    { "key": "building_features", "type": "multi_enum", "label": "В доме", "group": "house", "required": false,
      "options": [ { "value": "elevator", "label": "Лифт" }, { "value": "freight_elevator", "label": "Грузовой лифт" }, { "value": "parking", "label": "Парковка" }, { "value": "underground_parking", "label": "Подземный паркинг" }, { "value": "concierge", "label": "Консьерж" }, { "value": "closed_yard", "label": "Закрытый двор" }, { "value": "playground", "label": "Детская площадка" } ],
      "filter": {} },

    { "key": "mortgage", "type": "bool", "label": "Подходит под ипотеку", "group": "terms", "required": false,
      "depends_on": { "key": "deal_type", "values": ["sale"] },
      "filter": { "label": "Ипотека" } },
    { "key": "kids_allowed", "type": "bool", "label": "Можно с детьми", "group": "terms", "required": false,
      "depends_on": { "key": "deal_type", "values": ["rent_long", "rent_daily"] },
      "filter": {} },
    { "key": "pets_allowed", "type": "bool", "label": "Можно с животными", "group": "terms", "required": false,
      "depends_on": { "key": "deal_type", "values": ["rent_long", "rent_daily"] },
      "filter": {} },
    { "key": "utilities_included", "type": "bool", "label": "Коммунальные включены", "group": "terms", "required": false,
      "depends_on": { "key": "deal_type", "values": ["rent_long"] },
      "filter": {} },
    { "key": "amenities", "type": "multi_enum", "label": "Удобства", "group": "terms", "required": false,
      "depends_on": { "key": "deal_type", "values": ["rent_long", "rent_daily"] },
      "options": [ { "value": "furniture", "label": "Мебель" }, { "value": "fridge", "label": "Холодильник" }, { "value": "washer", "label": "Стиральная машина" }, { "value": "ac", "label": "Кондиционер" }, { "value": "internet", "label": "Интернет" }, { "value": "tv", "label": "Телевизор" }, { "value": "dishwasher", "label": "Посудомойка" } ],
      "filter": {} },
    { "key": "price_per_m2", "type": "int", "label": "Цена за м²", "unit": "₸", "group": "deal", "required": false, "computed": true,
      "depends_on": { "key": "deal_type", "values": ["sale"] },
      "filter": {} }
  ]
}
