    {"key": "origin", "type": "enum", "label": {"ru": "Происхождение", "uk": "Походження", "cs": "Původ", "en": "Origin"}, "group": "history", "required": false, "options": [{"value": "cz", "label": {"ru": "Куплен новым в Чехии", "uk": "Куплений новим у Чехії", "cs": "Původem z ČR", "en": "First sold in Czechia"}}, {"value": "imported", "label": {"ru": "Ввезён из-за границы", "uk": "Ввезений з-за кордону", "cs": "Dovoz", "en": "Imported"}}], "hint": {"ru": "Мотоцикл, проданный новым в Чехии, проще проверить: история у дилеров, пробег в базе STK. У ввезённых проверяйте по VIN.", "uk": "Мотоцикл, проданий новим у Чехії, легше перевірити: історія в дилерів, пробіг у базі STK. У ввезених перевіряйте за VIN.", "cs": "Motorka z ČR se snáz prověří: servisní historie u dealerů, nájezd v databázi STK. U dovozu si historii ověřte podle VIN.", "en": "Bikes first sold in CZ are easier to check: dealer service history, mileage in the STK database. For imports, check by VIN."}, "filter": {"facet": true}},
    {"key": "owners", "type": "int", "label": {"ru": "Владельцев", "uk": "Власників", "cs": "Počet majitelů", "en": "Owners"}, "group": "history", "required": false, "min": 1, "max": 20, "filter": {"label": {"ru": "Владельцев не больше", "uk": "Власників не більше", "cs": "Max. počet majitelů", "en": "Max. owners"}, "presets": [1, 2, 3]}},
    {"key": "stk_valid", "type": "bool", "label": {"ru": "Действующий техосмотр (STK)", "uk": "Чинний техогляд (STK)", "cs": "Platná STK", "en": "Valid roadworthiness test (STK)"}, "group": "history", "required": false, "hint": {"ru": "STK — обязательный техосмотр в Чехии: новый мотоцикл через 4 года, дальше каждые 2 года. Без действующего STK ездить нельзя.", "uk": "STK — обов'язковий техогляд у Чехії: новий мотоцикл через 4 роки, далі кожні 2 роки. Без чинного STK їздити не можна.", "cs": "Technická kontrola: nová motorka po 4 letech, poté každé 2 roky. Bez platné STK se nesmí jezdit.", "en": "STK is the mandatory Czech roadworthiness test: 4 years after first registration, then every 2 years. No valid STK, no riding."}, "filter": {"label": {"ru": "С действующим STK", "uk": "З чинним STK", "cs": "S platnou STK", "en": "Valid STK"}}},
